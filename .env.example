# ── Supabase (Postgres) ──────────────────────────────────────────────
# จาก Supabase > Project Settings > Database > Connection string
# ใช้ "Connection pooling" (port 6543) สำหรับ DATABASE_URL
# และ "Direct connection" (port 5432) สำหรับ DIRECT_URL
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth.js ──────────────────────────────────────────────────────────
# สร้างด้วย: npx auth secret  หรือ  openssl rand -base64 32
AUTH_SECRET=""
# Origin ของเว็บใน production (ใส่ http://localhost:3000 ตอน dev ไม่ต้องใส่ก็ได้)
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth ─────────────────────────────────────────────────────
# จาก Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Google Books API ─────────────────────────────────────────────────
# เปิดใช้ "Books API" ใน Google Cloud Console แล้วสร้าง API key
GOOGLE_BOOKS_API_KEY=""

# ── ใครสมัครใช้ได้ ──────────────────────────────────────────────────
# อีเมลที่อนุญาต คั่นด้วย comma (case-insensitive) เช่น "a@gmail.com,b@gmail.com"
# ถ้าว่างไว้ จะอนุญาตเฉพาะ AUTH_OWNER_EMAIL
ALLOWED_EMAILS=""
AUTH_OWNER_EMAIL=""
